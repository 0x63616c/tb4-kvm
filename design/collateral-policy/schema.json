{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0x63616c/tb4-kvm/design/collateral-policy/schema.json",
  "title": "TB4 KVM external collateral inventory",
  "type": "object",
  "required": ["schemaVersion", "issue", "policyStatus", "records", "ownerAdoption"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issue": { "const": 22 },
    "policyStatus": { "enum": ["PROPOSED", "REVIEWED", "ADOPTED"] },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" }, "uniqueItems": true },
    "ownerAdoption": {
      "type": "object", "additionalProperties": false, "required": ["status", "owner", "date", "evidence"],
      "properties": { "status": { "enum": ["NOT_REQUESTED", "PENDING", "ACCEPTED"] }, "owner": { "type": ["string", "null"] }, "date": { "type": ["string", "null"], "format": "date" }, "evidence": { "type": ["string", "null"], "minLength": 1 } }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "artifactKind", "classification", "sourceUrl", "accessedDate", "revision", "custodian", "terms", "redistribution", "repository", "hash", "review"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "title": { "type": "string", "minLength": 1 },
        "artifactKind": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["PUBLIC_LINK_ONLY", "OPEN_REDISTRIBUTABLE", "REGISTRATION_GATED", "NDA_CONFIDENTIAL", "OWNER_PRIVATE_METADATA_ONLY", "PROHIBITED", "UNKNOWN"] },
        "sourceUrl": { "type": ["string", "null"], "pattern": "^(https://|http://)" },
        "accessedDate": { "type": "string", "format": "date" },
        "revision": { "type": "string", "minLength": 1 },
        "custodian": { "enum": ["project", "owner", "vendor", "unknown"] },
        "terms": {
          "type": "object", "additionalProperties": false, "required": ["status", "url", "evidence"],
          "properties": { "status": { "enum": ["PUBLIC_LICENSE", "PROJECT_LICENSE", "WRITTEN_PERMISSION", "GATED", "NDA", "PRIVATE", "PROHIBITED", "UNKNOWN"] }, "url": { "type": ["string", "null"] }, "evidence": { "type": "string", "minLength": 1 } }
        },
        "redistribution": {
          "type": "object", "additionalProperties": false, "required": ["status", "evidence"],
          "properties": { "status": { "enum": ["PERMITTED", "FORBIDDEN", "FORBIDDEN_UNTIL_CONFIRMED", "UNKNOWN"] }, "evidence": { "type": "string", "minLength": 1 } }
        },
        "repository": {
          "type": "object", "additionalProperties": false, "required": ["artifactPath", "metadataPath", "notes"],
          "properties": { "artifactPath": { "type": ["string", "null"] }, "metadataPath": { "type": ["string", "null"] }, "notes": { "type": "string", "minLength": 1 } }
        },
        "hash": {
          "type": "object", "additionalProperties": false, "required": ["value", "algorithm", "permission", "permissionEvidence", "permissionEvidenceUrl", "basis"],
          "properties": { "value": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }, "algorithm": { "enum": ["sha256", null] }, "permission": { "enum": ["permitted", "not_permitted", "unknown", "not_applicable"] }, "permissionEvidence": { "enum": ["explicit-license", "written-permission", "none", "not-applicable"] }, "permissionEvidenceUrl": { "type": ["string", "null"] }, "basis": { "type": "string", "minLength": 1 } }
        },
        "review": {
          "type": "object", "additionalProperties": false, "required": ["status", "author", "independentReviewer", "attestation", "evidence", "date"],
          "properties": { "status": { "enum": ["UNREVIEWED", "REVIEWED", "BLOCKED"] }, "author": { "type": "string", "minLength": 1 }, "independentReviewer": { "type": ["string", "null"] }, "attestation": { "type": ["string", "null"] }, "evidence": { "type": "string", "minLength": 1 }, "date": { "type": "string", "format": "date" } }
        }
      }
    }
  }
}
