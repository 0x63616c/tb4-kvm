        "ports":{"type":"array","minItems":24,"items":{"type":"object","additionalProperties":false,"required":["id","lane","branch","polarity","singleEndedNumber","plane"],"properties":{"id":{"type":"string","minLength":1},"lane":{"enum":["D0","D1","D2","D3"]},"branch":{"enum":["HOST_A","COMMON","HOST_B"]},"polarity":{"enum":["P","N"]},"singleEndedNumber":{"type":"integer","minimum":1,"maximum":24},"plane":{"const":"CABLE_END"}}}},
        "pathTemplates":{"type":"object","additionalProperties":false,"required":["hostToCommon","hostBranchIsolation"],"properties":{"hostToCommon":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"hostBranchIsolation":{"type":"object","additionalProperties":false,"required":["directHostAToHostBNetAllowed","inactiveBranchTerminationRequired","allowedInactiveTerminationKinds"],"properties":{"directHostAToHostBNetAllowed":{"const":false},"inactiveBranchTerminationRequired":{"const":true},"allowedInactiveTerminationKinds":{"type":"array","minItems":2,"maxItems":2,"items":{"enum":["matched_50ohm","open"]}}}}}},
        "paths":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","lane","activeBranch","endpointPortIds"],"properties":{"id":{"type":"string","minLength":1},"lane":{"enum":["D0","D1","D2","D3"]},"activeBranch":{"enum":["HOST_A","HOST_B"]},"endpointPortIds":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"string","minLength":1}}}}}
