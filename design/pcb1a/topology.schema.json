    "componentSlots":{"type":"array","minItems":3,"items":{"type":"object","additionalProperties":false,"required":["id","function","sourceRecord","evidenceState","freezeStatus","footprintStatus","modelStatus","prototypeSourceStatus"],"properties":{"id":{"type":"string","minLength":1},"function":{"type":"string","minLength":1},"candidateMpn":{"type":"string","minLength":1},"candidateMpns":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"sourceRecord":{"const":"ISSUE5_PARTS_EVIDENCE"},"evidenceState":{"const":"BLOCKED"},"freezeStatus":{"type":"string","minLength":1},"footprintStatus":{"const":"NOT_FROZEN"},"modelStatus":{"type":"string","minLength":1},"prototypeSourceStatus":{"type":"string","minLength":1}}}},
    "controlAndPower":{"type":"object","additionalProperties":false,"required":["muxSupply","controls","allPathsDisabledByDefault","controlStateMappings","maxUncontrolledCurrentA","currentLimitStatus","powerDomain","noHostPowerPath"],"properties":{"muxSupply":{"type":"object","additionalProperties":false,"required":["net","nominalVoltageV","source","status"],"properties":{"net":{"const":"VCC_MUX"},"nominalVoltageV":{"const":1.8},"source":{"const":"EXTERNAL_CURRENT_LIMITED_BENCH_SUPPLY"},"status":{"const":"PROPOSED"}}},"controls":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["id","safeDefault","source"],"properties":{"id":{"enum":["MUX_ENABLE","MUX_SELECT"]},"safeDefault":{"type":"string","minLength":1},"source":{"const":"EXTERNAL_STATIC_TEST_CONTROL"}}}},"allPathsDisabledByDefault":{"const":true},"controlStateMappings":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","muxEnable","muxSelect"],"properties":{"id":{"type":"string","minLength":1},"muxEnable":{"enum":["DISABLED","ENABLED"]},"muxSelect":{"enum":["HOST_A","HOST_B"]}}}},"maxUncontrolledCurrentA":{"const":null},"currentLimitStatus":{"const":"BLOCKED_ON_DEVICE_AND_BENCH_SUPPLY_REVIEW"},"powerDomain":{"const":"RF_DEVICE_BIAS_ONLY"},"noHostPowerPath":{"const":true}}},
