  "invariants": [
    { "id": "INV-ROUTE-EXCLUSIVE", "description": "Independent A and B route commands and readbacks are mutually exclusive" },
    { "id": "INV-SOURCE-EXCLUSIVE", "description": "Independent A and B source commands and conduction readbacks are mutually exclusive" },
    { "id": "INV-MEASURED-DISCHARGE", "description": "A host change cannot authorize the other CC port until old VBUS is measured safe" },
    { "id": "INV-ORIENTATION-BEFORE-ROUTE", "description": "A data route cannot be enabled until that host orientation is known" },
    { "id": "INV-CONTRACT-BEFORE-READY", "description": "Ready requires a matching active PD contract and link evidence" },
    { "id": "INV-RESET-ALL-OFF", "description": "Reset commands every route, host source and CC policy off" },
    { "id": "INV-FAULT-EDGE", "description": "Every non-fault state has an asynchronous transition to the safe latched fault" },
    { "id": "INV-DOWNSTREAM-GATE", "description": "Unresolved downstream PD/power ownership blocks integrated design authorization" }
  ]
}
