{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0x63616c/tb4-kvm/design/product-decisions/response.schema.json",
  "title": "TB4 KVM v1 owner decision response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogIssue",
    "responseStatus",
    "answers",
    "notes",
    "ownerAcceptance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogIssue": { "const": 3 },
    "responseStatus": { "enum": ["DRAFT", "OWNER_ACCEPTED"] },
    "answers": { "type": "array", "items": { "$ref": "#/$defs/answer" } },
    "notes": { "type": "string" },
    "ownerAcceptance": { "$ref": "#/$defs/ownerAcceptance" }
  },
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "value"],
      "properties": {
        "decisionId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "ownerAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "date", "evidence", "acknowledgement"],
      "properties": {
        "owner": { "type": ["string", "null"] },
        "date": { "type": ["string", "null"], "format": "date" },
        "evidence": { "type": ["string", "null"] },
        "acknowledgement": {
          "anyOf": [
            { "type": "null" },
            { "const": "I accept these eight v1 product choices as the owner." }
          ]
        }
      }
    }
  }
}
