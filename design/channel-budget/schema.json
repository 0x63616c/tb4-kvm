{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0x63616c/tb4-kvm/design/channel-budget/schema.json",
  "title": "PCB-1A channel-budget allocation contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "claimBoundary", "board", "planes", "frequency", "ports", "mixedMode", "structures", "terminationNetworks", "authoritativeEvidence", "scenarios", "coupledLaneSets", "observables", "terms", "closure"],
  "properties": {
    "schemaVersion": {"const": 3},
    "status": {"enum": ["PROPOSED", "BLOCKED", "CLOSED_FOR_PROTOTYPE_ALLOCATION"]},
    "claimBoundary": {"type": "object", "additionalProperties": false, "required": ["couponPurpose", "usb4OrThunderboltComplianceClaimAuthorized", "prototypeAMeasurementRequiredBeforeOrder", "testOnly"], "properties": {"couponPurpose": {"const": "RF_ONLY_MUX_COUPON"}, "usb4OrThunderboltComplianceClaimAuthorized": {"const": false}, "prototypeAMeasurementRequiredBeforeOrder": {"const": false}, "testOnly": {"type": "boolean"}}},
    "board": {"type": "object", "additionalProperties": false, "required": ["revision", "serial"], "properties": {"revision": {"type": "string", "minLength": 1}, "serial": {"type": "string", "minLength": 1}}},
    "planes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["CABLE_END", "PCB_PACKAGE_LAND", "LOAD", "TEST_ONLY"]}, "description": {"type": "string", "minLength": 1}}}},
    "frequency": {"type": "object", "additionalProperties": false, "required": ["sweepStartHz", "sweepStopHz", "sampleHz", "validatedBandHz"], "properties": {"sweepStartHz": {"type": "number", "exclusiveMinimum": 0}, "sweepStopHz": {"type": "number", "exclusiveMinimum": 0}, "sampleHz": {"type": "array", "minItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}, "validatedBandHz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}}},
    "ports": {"type": "array", "minItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "singleEndedNumber", "pairId", "polarity", "branch", "planeId", "referenceImpedanceOhm"], "properties": {"id": {"type": "string", "minLength": 1}, "singleEndedNumber": {"type": "integer", "minimum": 1}, "pairId": {"type": "string", "minLength": 1}, "polarity": {"enum": ["P", "N"]}, "branch": {"enum": ["HOST_A", "HOST_B", "COMMON"]}, "planeId": {"type": "string", "minLength": 1}, "referenceImpedanceOhm": {"const": 50}}}},
    "mixedMode": {"type": "object", "additionalProperties": false, "required": ["order", "singleEndedReferenceOhm", "differentialReferenceOhm", "commonModeReferenceOhm", "conversionOrder"], "properties": {"order": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}, "singleEndedReferenceOhm": {"const": 50}, "differentialReferenceOhm": {"const": 100}, "commonModeReferenceOhm": {"const": 25}, "conversionOrder": {"const": "CALIBRATED_SINGLE_ENDED_THEN_DEEMBEDDED_THEN_RENORMALIZED_THEN_MIXED_MODE"}}},
    "structures": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["DUT_FIXTURE", "PLAIN_THRU_COMPARATOR", "2X_THRU", "TERMINATION_FIXTURE"]}}}},
    "terminationNetworks": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "planeId", "perPort"], "properties": {"id": {"type": "string", "minLength": 1}, "planeId": {"type": "string", "minLength": 1}, "perPort": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["portId", "termination"], "properties": {"portId": {"type": "string", "minLength": 1}, "termination": {"enum": ["matched_50ohm", "open", "HiZ", "measurement_port"]}}}}}}},
    "authoritativeEvidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "description"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"enum": ["DATASHEET_OR_MODEL", "MODEL", "MEASUREMENT", "REQUIREMENT", "STACKUP", "TEST_ONLY"]}, "description": {"type": "string", "minLength": 1}}}},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "lane", "direction", "dutState", "fixtureStructureId", "terminationNetworkId", "inactiveTermination", "powerState", "temperatureC", "applicability", "exclusionReason", "hiZAuthorityEvidenceId"], "properties": {"id": {"type": "string", "minLength": 1}, "lane": {"enum": ["D0", "D1", "D2", "D3"]}, "direction": {"enum": ["forward", "reverse"]}, "dutState": {"enum": ["A_SELECTED_B_MATCHED", "B_SELECTED_A_MATCHED", "A_SELECTED_B_OPEN", "B_SELECTED_A_OPEN", "UNPOWERED", "POWERED_ALL_PATHS_HIZ"]}, "fixtureStructureId": {"type": "string", "minLength": 1}, "terminationNetworkId": {"type": "string", "minLength": 1}, "inactiveTermination": {"enum": ["matched_50ohm", "open", "HiZ", "not_applicable"]}, "powerState": {"enum": ["unpowered", "powered"]}, "temperatureC": {"type": "number"}, "applicability": {"enum": ["APPLIES", "EXCLUDED"]}, "exclusionReason": {"type": "string"}, "hiZAuthorityEvidenceId": {"type": ["string", "null"]}}}},
    "coupledLaneSets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "lanes", "scenarioIds"], "properties": {"id": {"type": "string", "minLength": 1}, "lanes": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"enum": ["D0", "D1", "D2", "D3"]}}, "scenarioIds": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}}}}},
    "observables": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "domain", "scope", "reducer"], "properties": {"id": {"type": "string", "minLength": 1}, "domain": {"enum": ["INSERTION_LOSS_DB", "RETURN_LOSS_DB", "COUPLING_DB", "GROUP_DELAY_PS", "LANE_SKEW_PS"]}, "scope": {"enum": ["PER_SCENARIO", "COUPLED_LANE_SET"]}, "reducer": {"enum": ["MAXIMUM", "MINIMUM"]}, "targetPs": {"type": "number"}}}},
    "terms": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "observableId", "scenarioId", "coupledLaneSetId", "measurementPath", "role", "samples", "designMargin", "evidence", "uncertainty"], "properties": {"id": {"type": "string", "minLength": 1}, "observableId": {"type": "string", "minLength": 1}, "scenarioId": {"type": ["string", "null"]}, "coupledLaneSetId": {"type": ["string", "null"]}, "measurementPath": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["TRANSMISSION", "REFLECTION", "COUPLING"]}, "fromPortId": {"type": "string"}, "toPortId": {"type": "string"}, "atPortId": {"type": "string"}, "aggressorPortId": {"type": "string"}, "victimPortId": {"type": "string"}}}, "role": {"enum": ["NETWORK_RESULT", "ALLOCATION_PENALTY", "COUPLED_DERIVED"]}, "samples": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["frequencyHz", "value"], "properties": {"frequencyHz": {"type": "number", "exclusiveMinimum": 0}, "value": {"type": "number"}}}}, "designMargin": {"type": "number", "minimum": 0}, "evidence": {"type": "object", "additionalProperties": false, "required": ["grade", "state", "evidenceIds"], "properties": {"grade": {"enum": ["A_MEASURED", "B_MODELED", "C_VENDOR_REFERENCE", "D_ASSUMPTION", "TBD"]}, "state": {"enum": ["PROPOSED", "MODELED", "MEASURED", "REVIEWED", "VALIDATED"]}, "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}}}, "uncertainty": {"type": "object", "additionalProperties": false, "required": ["combinationRule", "contributors", "uc", "coverageFactorK", "expandedU"], "properties": {"combinationRule": {"enum": ["INDEPENDENT_RSS", "CONSERVATIVE_SUM", "COVARIANCE"]}, "contributors": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "standardUncertainty", "unit", "distribution", "sensitivity", "sharing"], "properties": {"id": {"type": "string", "minLength": 1}, "standardUncertainty": {"type": "number", "minimum": 0}, "unit": {"enum": ["dB", "ps"]}, "distribution": {"enum": ["NORMAL", "RECTANGULAR", "TRIANGULAR", "OTHER_REVIEWED"]}, "sensitivity": {"type": "number"}, "sharing": {"enum": ["INDEPENDENT", "SHARED"]}}}}, "correlationMatrix": {"type": "array", "items": {"type": "array", "items": {"type": "number", "minimum": -1, "maximum": 1}}}, "uc": {"type": "number", "minimum": 0}, "coverageFactorK": {"type": "number", "exclusiveMinimum": 0}, "expandedU": {"type": "number", "minimum": 0}}}}}},
    "closure": {"type": "object", "additionalProperties": false, "required": ["requiredObservableIds", "limits", "acceptedEvidenceIds", "tbdFields", "allocationPassAuthorized"], "properties": {"requiredObservableIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "limits": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observableId", "scenarioId", "coupledLaneSetId", "limit", "basis", "worstFrequencyHz"], "properties": {"observableId": {"type": "string", "minLength": 1}, "scenarioId": {"type": ["string", "null"]}, "coupledLaneSetId": {"type": ["string", "null"]}, "limit": {"type": "number"}, "basis": {"enum": ["INTEGRATED_REQUIREMENT", "ACCEPTED_ENGINEERING_ALLOCATION", "SYNTHETIC_TEST_ONLY"]}, "worstFrequencyHz": {"type": "number", "exclusiveMinimum": 0}}}}, "acceptedEvidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "tbdFields": {"type": "array", "items": {"type": "string", "minLength": 1}}, "allocationPassAuthorized": {"type": "boolean"}}}
  }
}
