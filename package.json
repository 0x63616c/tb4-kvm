{
  "name": "tb4-kvm-field-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "PAGES_STATIC_EXPORT=true PAGES_BASE_PATH=/tb4-kvm vinext build && PAGES_BASE_PATH=/tb4-kvm node scripts/assemble-pages-hub.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "verify:control": "node scripts/verify-control-model.mjs",
    "verify:pcb1a": "node scripts/verify-pcb1a-plan.mjs",
    "verify:channel-budget": "node design/channel-budget/validate.mjs",
    "verify:collateral": "node design/collateral-policy/validate.mjs && node design/collateral-policy/test.mjs",
    "verify:evidence": "node scripts/verify-evidence-ledger.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt app components lib scripts package.json tsconfig.json vite.config.ts next.config.ts",
    "format:check": "oxfmt --check app components lib scripts package.json tsconfig.json vite.config.ts next.config.ts",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run verify:control && npm run verify:pcb1a && npm run verify:channel-budget && npm run verify:collateral && npm run verify:evidence && npm run verify:links && npm run audit && npm run verify:sbom && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260901.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "ajv": "^8.20.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
